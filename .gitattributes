# اتساق الـ line endings — المشروع بيتشغّل على Linux (Kaggle/GitHub)
# ويتحرَّر على Windows ⇒ نثبّت LF لكل الملفات النصية عشان مفيش churn
# ولا اختلاف في البصمات بين الأجهزة.

* text=auto

*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.jinja text eol=lf

# ملفات ثنائية
*.xlsx binary
*.gguf binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.zip  binary
